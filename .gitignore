# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
tsconfig.tsbuildinfo

# Tauri's frontendDist placeholder. This fork ships no frontend, but the
# desktop shell still compiles (972 `feature = "tauri-runtime"` sites across 56
# files — removing it is a different, much larger job), and tauri-build
# validates `frontendDist` / the bundled `../out` resource during compilation.
# So `out/index.html` is tracked as an empty placeholder and nothing else in
# `out/` is.
/out/*
!/out/index.html

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test artifacts
coverage/
*.snap.new
.vitest-cache/

# macOS signing material. Keep certificates and exported private keys out of git.
*.cer
*.csr
*.p12
certificate-base64.txt

# Agent
.claude
.docs
docs/superpowers

# Tauri sidecar staging (built per-target by prepare-sidecars.mjs).
# The binaries are platform-specific build artifacts; ship them through
# release.yml, not git.
src-tauri/binaries/

# pnpm local store (pnpm 11+)
.pnpm-store/

# `rustc foo.rs` with no -o writes its binary here. Scratch compiles are how
# you check a borrow or a lifetime question in isolation, and the leftover
# executable then sits untracked in the repo root — which is enough to fail a
# work task's "worktree is clean" check at delivery.
/rust_out
